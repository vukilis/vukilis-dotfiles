* {
    /* Your Palette + Derived Surface Shades */
    bg:          #161616;
    bg-alt:      #1f1f1f;
    fg:          #f2ede4;
    fg-muted:    #7a746b;
    accent:      #e5b566;
    border-col:  #2c2c2c;

    /* Global Defaults */
    background-color: transparent;
    text-color:       @fg;
    font:             "Sora 11";
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    location:         west;
    anchor:           west;
    height:           100%;
    width:            360px;
    background-color: @bg;
    border:           0 1px 0 0;
    border-color:     @accent;
}

mainbox {
    padding:          24px 18px;
    spacing:          18px;
    children:         [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @accent;
    border-radius:    12px;
    padding:          12px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
    font:             "Sora SemiBold 12";
}

entry {
    placeholder:       "Search apps...";
    placeholder-color: @fg-muted;
    text-color:        @fg;
    cursor:            text;
}

listview {
    lines:            12;
    columns:          1;
    fixed-height:     false;
    scrollbar:        false;
    spacing:          6px;
}

element {
    padding:          10px 12px;
    spacing:          12px;
    border-radius:    10px;
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @bg-alt;
    text-color:       @accent;
}

element-icon {
    size:             24px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
}