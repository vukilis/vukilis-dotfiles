# ALIAS
alias cat='bat -pp'
alias less='bat --paging=always'
alias l='lsd -l --color=auto'
alias ll='lsd -la --color=auto'
alias ls='lsd --color=auto'
alias grep='rg'
alias find='fd -uuu'
alias fp='fzf --preview "bat --style=numbers --color=always --line-range :500 {}"'
alias zshrc='${=EDITOR} ~/.zshrc'
alias pp10k='${=EDITOR} ~/.p10k.zsh'
alias h='history'
alias p='ps -f'
alias spwd='echo "$(whoami)@$(hostname --fqdn):$PWD"'
alias kitty-ssh='kitty +kitten ssh' 
alias btm='btm -cT'
alias ncdu='ncdu -x ~/'
alias du='duf --sort size'
alias curl='curlie'
alias ssl-c='ssh-keygen -y -f'
# alias code='codium'
alias fixvbox='sudo pkill -fx "/usr/bin/VBoxClient --draganddrop"'
alias fixmouse='sudo chmod a+rw /dev/hidraw3'
alias app-total-space="pacman -Qi | awk '/^Installed Size/ {val=\$4; unit=\$5; if (unit == \"KiB\") { sum += val / 1024 / 1024 } else if (unit == \"MiB\") { sum += val / 1024 } else if (unit == \"GiB\") { sum += val }} END { printf \"Actual Package Total: %.2f GB\n\", sum }'"
alias app-space='pacman -Qi | awk '\''/^Name/ {pkg=$3} /^Installed Size/ {val=$4; unit=$5; if (unit=="KiB") val=val/1024; if (unit=="GiB") val=val*1024; printf "%.2f MB \t %s\n", val, pkg}'\'' | sort -n'
alias snap-space='sudo sudbtrfs qgroup show -pcre /'
alias fixpicom='killall picom; sleep 0.2; picom --config ~/.config/picom/picom.conf & disown'
alias micnoise='pipewire -c filter-chain.conf'
alias birth='stat / | grep "Birth"'